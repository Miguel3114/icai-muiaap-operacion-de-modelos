{
  "components": {
    "schemas": {
      "ErrorCode": {
        "description": "Códigos estables: el cliente programa contra ellos, no contra el texto.",
        "enum": [
          "invalid_json",
          "validation_error",
          "not_found",
          "method_not_allowed",
          "http_error",
          "model_unavailable",
          "internal_error"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorDetail": {
        "description": "Descripción estable del error.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "fields": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Solo presente en errores de validación.",
            "title": "Fields"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Sobre común de todas las respuestas de error (contrato de S7).",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "error",
          "request_id"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "FieldError": {
        "description": "Un campo del cuerpo que incumple el contrato.",
        "properties": {
          "field": {
            "examples": [
              "features.alcohol"
            ],
            "title": "Field",
            "type": "string"
          },
          "message": {
            "examples": [
              "Input should be a valid number"
            ],
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Estado del servicio y del modelo cargado.",
        "properties": {
          "model_status": {
            "const": "ready",
            "title": "Model Status",
            "type": "string"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "model_status",
          "model_version",
          "request_id"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Prediction": {
        "description": "Predicción pública: no incluye puntuaciones internas del modelo.",
        "properties": {
          "confidence": {
            "title": "Confidence",
            "type": "number"
          },
          "model_version": {
            "minLength": 1,
            "title": "Model Version",
            "type": "string"
          },
          "preprocessing_version": {
            "minLength": 1,
            "title": "Preprocessing Version",
            "type": "string"
          },
          "quality_band": {
            "$ref": "#/components/schemas/QualityBand"
          }
        },
        "required": [
          "quality_band",
          "confidence",
          "model_version",
          "preprocessing_version"
        ],
        "title": "Prediction",
        "type": "object"
      },
      "PredictionRequest": {
        "additionalProperties": false,
        "description": "Cuerpo de `POST /v1/predictions`.",
        "properties": {
          "features": {
            "$ref": "#/components/schemas/WineFeatures"
          }
        },
        "required": [
          "features"
        ],
        "title": "PredictionRequest",
        "type": "object"
      },
      "PredictionResponse": {
        "description": "Respuesta de `POST /v1/predictions`.",
        "properties": {
          "prediction": {
            "$ref": "#/components/schemas/Prediction"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "served_at": {
            "title": "Served At",
            "type": "string"
          }
        },
        "required": [
          "prediction",
          "request_id",
          "served_at"
        ],
        "title": "PredictionResponse",
        "type": "object"
      },
      "QualityBand": {
        "description": "Bandas de calidad que entiende el consumidor.",
        "enum": [
          "needs_review",
          "acceptable",
          "excellent"
        ],
        "title": "QualityBand",
        "type": "string"
      },
      "WineFeatures": {
        "additionalProperties": false,
        "description": "Once variables fisicoquímicas de un vino tinto, con rangos inclusivos.",
        "properties": {
          "alcohol": {
            "description": "Alcohol (% vol.).",
            "maximum": 20.0,
            "minimum": 5.0,
            "title": "Alcohol",
            "type": "number"
          },
          "chlorides": {
            "description": "Cloruros (g/dm³).",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Chlorides",
            "type": "number"
          },
          "citric_acid": {
            "description": "Ácido cítrico (g/dm³).",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Citric Acid",
            "type": "number"
          },
          "density": {
            "description": "Densidad (g/cm³).",
            "maximum": 1.01,
            "minimum": 0.98,
            "title": "Density",
            "type": "number"
          },
          "fixed_acidity": {
            "description": "Acidez fija (g/dm³).",
            "maximum": 20.0,
            "minimum": 0.0,
            "title": "Fixed Acidity",
            "type": "number"
          },
          "free_sulfur_dioxide": {
            "description": "Dióxido de azufre libre (mg/dm³).",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Free Sulfur Dioxide",
            "type": "number"
          },
          "ph": {
            "description": "pH.",
            "maximum": 4.5,
            "minimum": 2.5,
            "title": "Ph",
            "type": "number"
          },
          "residual_sugar": {
            "description": "Azúcar residual (g/dm³).",
            "maximum": 20.0,
            "minimum": 0.0,
            "title": "Residual Sugar",
            "type": "number"
          },
          "sulphates": {
            "description": "Sulfatos (g/dm³).",
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Sulphates",
            "type": "number"
          },
          "total_sulfur_dioxide": {
            "description": "Dióxido de azufre total (mg/dm³).",
            "maximum": 300.0,
            "minimum": 0.0,
            "title": "Total Sulfur Dioxide",
            "type": "number"
          },
          "volatile_acidity": {
            "description": "Acidez volátil (g/dm³).",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Volatile Acidity",
            "type": "number"
          }
        },
        "required": [
          "fixed_acidity",
          "volatile_acidity",
          "citric_acid",
          "residual_sugar",
          "chlorides",
          "free_sulfur_dioxide",
          "total_sulfur_dioxide",
          "density",
          "ph",
          "sulphates",
          "alcohol"
        ],
        "title": "WineFeatures",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "\nClasifica un vino tinto en `needs_review`, `acceptable` o `excellent`.\n\n**Trazabilidad.** Cada respuesta incluye un `request_id`, también en la\ncabecera `X-Request-Id`. Cítalo al reportar una incidencia.\n\n**Errores.** Todos los errores usan el mismo sobre:\n\n```json\n{\"error\": {\"code\": \"validation_error\", \"message\": \"...\", \"fields\": [...]},\n \"request_id\": \"req_...\"}\n```\n\nPrograma contra `error.code`, no contra el texto de `message`.\n",
    "summary": "Predicción de la calidad de vino tinto a partir de su analítica.",
    "title": "Wine Quality API",
    "version": "1.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Indica si la API puede atender predicciones.\n\nÚsalo como sonda de disponibilidad (readiness) antes de enviar tráfico.\nUn `503` con `error.code = model_unavailable` significa que el proceso\nestá vivo pero el modelo no se ha cargado: reintenta más tarde.",
        "operationId": "read_health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "El servicio está activo y el modelo listo para predecir."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "El modelo no está cargado; no envíes predicciones."
          }
        },
        "summary": "Comprobar el estado del servicio",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/predictions": {
      "post": {
        "description": "Clasifica un vino tinto en una banda de calidad.\nEnvía las once variables fisicoquímicas en `features`; todos los rangos son\ninclusivos y no se admiten campos extra. La respuesta incluye\n`quality_band`, `confidence` redondeada a dos decimales, las versiones del\nmodelo y del preprocesado y `served_at` en UTC (ISO 8601 con `Z`).",
        "operationId": "create_prediction_v1_predictions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "out_of_range": {
                  "summary": "Alcohol fuera de rango (422)",
                  "value": {
                    "features": {
                      "alcohol": 25.0,
                      "chlorides": 0.076,
                      "citric_acid": 0.0,
                      "density": 0.9978,
                      "fixed_acidity": 7.4,
                      "free_sulfur_dioxide": 11.0,
                      "ph": 3.51,
                      "residual_sugar": 1.9,
                      "sulphates": 0.56,
                      "total_sulfur_dioxide": 34.0,
                      "volatile_acidity": 0.7
                    }
                  }
                },
                "valid": {
                  "description": "Las once variables dentro de rango.",
                  "summary": "Vino válido",
                  "value": {
                    "features": {
                      "alcohol": 9.4,
                      "chlorides": 0.076,
                      "citric_acid": 0.0,
                      "density": 0.9978,
                      "fixed_acidity": 7.4,
                      "free_sulfur_dioxide": 11.0,
                      "ph": 3.51,
                      "residual_sugar": 1.9,
                      "sulphates": 0.56,
                      "total_sulfur_dioxide": 34.0,
                      "volatile_acidity": 0.7
                    }
                  }
                },
                "wrong_type": {
                  "summary": "Texto en un campo numérico (422)",
                  "value": {
                    "features": {
                      "alcohol": 9.4,
                      "chlorides": 0.076,
                      "citric_acid": 0.0,
                      "density": 0.9978,
                      "fixed_acidity": 7.4,
                      "free_sulfur_dioxide": 11.0,
                      "ph": "ácido",
                      "residual_sugar": 1.9,
                      "sulphates": 0.56,
                      "total_sulfur_dioxide": 34.0,
                      "volatile_acidity": 0.7
                    }
                  }
                }
              },
              "schema": {
                "$ref": "#/components/schemas/PredictionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionResponse"
                }
              }
            },
            "description": "Banda de calidad, confianza y versiones del modelo."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "El cuerpo no es JSON válido."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "JSON válido que incumple el contrato de entrada; `error.fields` indica qué campos."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "El modelo no está disponible."
          }
        },
        "summary": "Predecir la calidad de un vino tinto",
        "tags": [
          "predictions"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Estado del servicio y del modelo cargado.",
      "name": "health"
    },
    {
      "description": "Inferencia de calidad de vino tinto.",
      "name": "predictions"
    }
  ]
}
